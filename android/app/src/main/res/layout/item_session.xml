<?xml version="1.0" encoding="utf-8"?>
<!-- session 列表项：名称 + 时间 + 删除按钮 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:padding="12dp"
    android:gravity="center_vertical">
    <LinearLayout android:orientation="vertical" android:layout_width="0dp"
        android:layout_height="wrap_content" android:layout_weight="1">
        <TextView android:id="@+id/tvName" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="16sp"
            android:textStyle="bold" />
        <TextView android:id="@+id/tvMeta" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="12sp"
            android:textColor="#888888" />
    </LinearLayout>
    <Button android:id="@+id/btnDelete" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text="@string/delete" />
</LinearLayout>
