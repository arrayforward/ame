<?xml version="1.0" encoding="utf-8"?>
<!-- 消息列表项：可选缩略图 + 文本；按角色切换对齐/底色 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/msgRoot" android:orientation="vertical"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:padding="6dp">
    <ImageView android:id="@+id/ivMsg" android:layout_width="120dp"
        android:layout_height="120dp" android:scaleType="centerCrop"
        android:visibility="gone" />
    <TextView android:id="@+id/tvMsg" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:padding="4dp"
        android:textSize="15sp" android:textIsSelectable="true" />
</LinearLayout>
