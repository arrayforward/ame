<?xml version="1.0" encoding="utf-8"?>
<!-- 诊断列表行：摘要标题 + 统计副标题 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:padding="8dp">
    <TextView android:id="@+id/tvDiagTitle" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="14sp"
        android:textColor="#222222" />
    <TextView android:id="@+id/tvDiagSub" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="12sp"
        android:textColor="#777777" android:paddingTop="2dp" />
</LinearLayout>
